{
  "name": "market-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @market-rush/web",
    "build": "npm run build -w @market-rush/web && tsc -p serverless/tsconfig.json",
    "start": "npm run dev",
    "verify:function": "node scripts/verify-function.mjs",
    "package:netlify": "node scripts/package-netlify.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p serverless/tsconfig.json"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^16.3.1",
    "@types/node": "^24.0.0",
    "fflate": "^0.8.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4"
  }
}
